# A truly clean `npm install` (fresh checkout, no node_modules/package-lock.json)
# crashes npm's Arborist dependency resolver with
# "TypeError: Cannot read properties of null (reading 'edgesOut')" — a known
# npm bug in its ideal-tree builder triggered by a peer-dependency cycle
# involving vitest's newer plugin packages (@vitest/browser-playwright and
# related). legacy-peer-deps switches to the simpler npm v6-style resolver,
# which does not hit this code path. Found and fixed while investigating
# `npm audit` findings — this is unrelated to any application dependency and
# affects any fresh install of this repo, not just this one.
legacy-peer-deps=true
