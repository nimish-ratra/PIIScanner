# ─── Authentication mode ─────────────────────────────────────────────────────
# Values: password | e2e
# e2e is BLOCKED in production (NODE_ENV=production).
# "password" is the only Customer Admin login path — Trustfabric-managed
# email/password credentials, verified against User.passwordHash (argon2id).
# OIDC/SSO was removed; this does not affect Vendor or Agent authentication,
# which are separate systems.
AUTH_MODE=password

# ─── Session ─────────────────────────────────────────────────────────────────
# At least 32 random characters — generate with: openssl rand -hex 32
# NEVER commit an actual value. Use secret management in production.
SESSION_SECRET=

# Cookie name for the application session
SESSION_COOKIE_NAME=TF_SESSION

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# 3000 = Customer Portal, 3002 = Trustfabric Admin (vendor portal), 4100 = Customer Portal e2e/dev-alt port.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:4100

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://admin:password@localhost:5432/licensing

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
