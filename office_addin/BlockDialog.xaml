<Window x:Class="PIISentinel.OfficeAddin.BlockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PII Sentinel — Save Blocked" Height="520" Width="640"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0f172a" Foreground="#f8fafc" FontFamily="Segoe UI"
        Topmost="True" ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="🛡️" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Save Blocked: Sensitive PII Detected" FontSize="18" FontWeight="Bold" Foreground="#f8fafc"/>
                <TextBlock Text="PII Sentinel Real-Time Document Protection" FontSize="12" Foreground="#94a3b8"/>
            </StackPanel>
        </StackPanel>

        <!-- Tier Card -->
        <Border Grid.Row="1" Background="#1e293b" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="BadgeBorder" Background="#2e1065" BorderBrush="#a855f7" BorderThickness="1" CornerRadius="14" Padding="12,4" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtBadge" Text="🟣 Restricted" Foreground="#d8b4fe" FontWeight="Bold" FontSize="13"/>
                </Border>
                <TextBlock x:Name="TxtRationale" Grid.Column="1" Margin="14,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="Document contains developer credentials or sensitive government IDs." Foreground="#cbd5e1" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Findings List Box -->
        <GroupBox Grid.Row="2" Header="Detected PII Entities (Safe Redacted Preview)" Foreground="#94a3b8" FontSize="12" Margin="0,0,0,14" BorderBrush="#334155">
            <ListBox x:Name="LstFindings" Background="#0b1120" BorderThickness="0" Margin="4,8,4,4" Foreground="#f1f5f9"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#1e293b" BorderThickness="0,0,0,1" Padding="6,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding entity_type}" FontWeight="SemiBold" Foreground="#38bdf8"/>
                                <TextBlock Grid.Column="1" Text="{Binding redacted_value}" FontFamily="Consolas" Foreground="#fca5a5"/>
                                <TextBlock Grid.Column="2" Text="{Binding confidence, StringFormat='{}{0:P0}'}" Foreground="#94a3b8" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!-- Override Expander -->
        <Expander x:Name="ExpOverride" Grid.Row="3" Header="⚠️ Override &amp; Save Anyway (Requires Justification)" Foreground="#fbbf24" Margin="0,0,0,16">
            <Border Background="#1e293b" BorderBrush="#d97706" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="Enter reason for overriding the corporate security policy (logged to audit trail):" Foreground="#fef3c7" FontSize="11" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtOverrideReason" Height="48" TextWrapping="Wrap" Background="#0f172a" Foreground="#f8fafc"
                             BorderBrush="#475569" Padding="6" TextChanged="TxtOverrideReason_TextChanged"/>
                    <Button x:Name="BtnConfirmOverride" Content="Confirm Override &amp; Save" HorizontalAlignment="Right" Margin="0,8,0,0"
                            Background="#b45309" BorderBrush="#d97706" Foreground="#ffffff" IsEnabled="False" Click="BtnConfirmOverride_Click"/>
                </StackPanel>
            </Border>
        </Expander>

        <!-- Actions -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnOpenApp" Content="🔍 Open in PII Sentinel" Background="#1e293b" BorderBrush="#3b82f6" Foreground="#60a5fa" Click="BtnOpenApp_Click"/>
            <Button x:Name="BtnCancel" Grid.Column="2" Content="Cancel Save" Background="#ef4444" BorderBrush="#b91c1c" Foreground="#ffffff" IsDefault="True" Click="BtnCancel_Click"/>
        </Grid>
    </Grid>
</Window>
